<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RimWorld 1.6 build of the main assembly. The C# is shared: every version compiles
    the same files from the mod's top-level Source/ folder, and RW16 / RW17 are defined
    for the places where the game versions differ. Output goes to 1.6/Assemblies, which
    LoadFolders.xml loads only on 1.6.

    The 1.6 game is no longer installed on this machine, so the game references come
    from the Krafs.Rimworld.Ref package (reference assemblies of a 1.6 build) instead
    of the install folder.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>MountedWeapons</AssemblyName>
    <RootNamespace>MountedWeapons</RootNamespace>
    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);RW16</DefineConstants>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Top level only: Compat/ is its own assembly, and obj/ holds generated files. -->
    <Compile Include="..\..\Source\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" PrivateAssets="all">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Lib.Harmony" Version="2.4.1" PrivateAssets="all">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
