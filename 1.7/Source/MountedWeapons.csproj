<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RimWorld 1.7 build of the main assembly. Same shared C# as 1.6/Source (the mod's
    top-level Source/ folder), compiled against the installed 1.7 game with RW17
    defined. Output goes to 1.7/Assemblies, which LoadFolders.xml loads only on 1.7.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>MountedWeapons</AssemblyName>
    <RootNamespace>MountedWeapons</RootNamespace>
    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);RW17</DefineConstants>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RimWorldBin>/Users/tirrella/Library/Application Support/Steam/steamapps/common/RimWorld/RimWorld.app/Contents/MacOS/</RimWorldBin>
  </PropertyGroup>
  <ItemGroup>
    <!-- Top level only: Compat/ is its own assembly, and obj/ holds generated files. -->
    <Compile Include="..\..\Source\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.4.1" PrivateAssets="all">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldBin)Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldBin)UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldBin)Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
