<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Automated mounts: a core aims the weapon instead of a gunner. The core is in the
       cost list and on the leavingsBlacklist; Building_WeaponMount returns it on
       deconstruction and loses it on a 50% roll when the mount is destroyed. -->
  <ThingDef Name="MW_AutoMountBase" ParentName="MW_WeaponMountBase" Abstract="True">
    <fillPercent>0.5</fillPercent>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Stunnable">
        <affectedDamageDefs>
          <li>Stun</li>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="MW_AutoMountBase">
    <defName>MW_AutoMountBasic</defName>
    <label>basic auto-mount</label>
    <description>A powered weapon mount run by a basic subcore. It aims and fires the mounted weapon on its own at 120% of its normal range, with the accuracy of a level 6 shooter.\n\nDeconstructing it returns the subcore. If the mount is destroyed, there is a 50% chance the subcore is lost.</description>
    <graphicData>
      <texPath>Things/Building/Security/MW_AutoMountBasic</texPath>
    </graphicData>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
      <SubcoreBasic>1</SubcoreBasic>
    </costList>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <WorkToBuild>3000</WorkToBuild>
      <Mass>30</Mass>
      <Beauty>-10</Beauty>
      <ShootingAccuracyTurret>0.95</ShootingAccuracyTurret>
    </statBases>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
    </comps>
    <building>
      <leavingsBlacklist>
        <li>SubcoreBasic</li>
      </leavingsBlacklist>
    </building>
    <researchPrerequisites>
      <li>MW_AutomatedMounts</li>
    </researchPrerequisites>
    <modExtensions>
      <li Class="MountedWeapons.MountExtension">
        <coreDef>SubcoreBasic</coreDef>
        <rangeMultiplier>1.2</rangeMultiplier>
        <warmupFactor>1.0</warmupFactor>
      </li>
    </modExtensions>
  </ThingDef>

