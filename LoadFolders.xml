  <v1.6>
    <li>/</li>
    <li>1.6</li>
    <!-- Automated mounts run on mech subcores, which only exist with Biotech.
         Without it the whole automated branch (buildings and research) is skipped. -->
    <li IfModActive="Ludeon.RimWorld.Biotech">Biotech</li>
    <!-- Mounts use and reload ammo when Progression: Ammunition is active. Its assembly
         references that mod's DLL, so it must never load without it. -->
    <li IfModActive="ferny.ProgressionAmmunition">Compat/ProgressionAmmunition</li>
    <li IfModActive="ferny.ProgressionAmmunition">Compat/ProgressionAmmunition/1.6</li>
  </v1.6>
