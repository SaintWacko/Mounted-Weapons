<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build entry point only: compiles nothing and ships nothing (its own output stays in
    Source/bin, which is never published). Circinus's build looks for a .csproj in
    Source/, and the real projects live in 1.6/Source,
    1.7/Source and Source/Compat/ProgressionAmmunition/<version>. Referencing the two
    compat projects builds everything: each one references the main project for its
    game version, so the order is main 1.6, compat 1.6, main 1.7, compat 1.7.

    Open this project in an IDE to get all four. It has to be the only project file
    directly in Source/, or `dotnet build` there stops and asks which one to build.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>MountedWeapons.Build</AssemblyName>
    <!-- The 1.7 projects compile against the installed 1.7 game. When it is not on disk
         (Steam switched back to 1.6), they are skipped and the 1.7 DLLs already in
         1.7/Assemblies are left as they are. -->
    <RW17Managed>/Users/tirrella/Library/Application Support/Steam/steamapps/common/RimWorld/RimWorld.app/Contents/MacOS/Assembly-CSharp.dll</RW17Managed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Compat\ProgressionAmmunition\1.6\MountedWeapons.ProgressionAmmunition.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="Compat\ProgressionAmmunition\1.7\MountedWeapons.ProgressionAmmunition.csproj" Condition="Exists('$(RW17Managed)')">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <Target Name="ReportSkipped17" BeforeTargets="Build" Condition="!Exists('$(RW17Managed)')">
    <Message Importance="high" Text="RimWorld 1.7 is not installed: skipped the 1.7 projects. 1.7/Assemblies keeps its last build." />
  </Target>
</Project>
